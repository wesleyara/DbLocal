{
  "name": "dblocal",
  "version": "1.0.2",
  "license": "MIT",
  "description": "Local database browser with navigable relations, a SQL editor and an ERD, for Postgres, MySQL and SQLite.",
  "bin": {
    "dblocal": "bin/dblocal.mjs"
  },
  "files": [
    "LICENSE",
    "bin",
    ".output",
    "CHANGELOG.md"
  ],
  "keywords": [
    "database",
    "postgres",
    "mysql",
    "sqlite",
    "sql",
    "studio",
    "browser"
  ],
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev --port 5555",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:seed": "node scripts/db.mjs seed",
    "help:shots": "node scripts/help-screenshots.mjs",
    "prepare": "nuxt prepare",
    "prepack": "pnpm build",
    "start": "node bin/dblocal.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.143",
    "@libsql/client": "^0.18.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.0.1",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/test-utils": "^4.3.3",
    "@nuxtjs/i18n": "^10.6.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@pinia/nuxt": "^1.0.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-table": "^9.3.1",
    "@tanstack/vue-virtual": "^3.13.44",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/ssh2": "^1.15.6",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "better-sqlite3": "^13.0.3",
    "cuid": "^3.0.0",
    "elkjs": "^0.12.0",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.1",
    "highlight.js": "^11.12.0",
    "kysely": "^0.29.6",
    "marked": "14.0.0",
    "md-editor-v3": "6.5.6",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "mysql2": "^3.24.6",
    "nanoid": "^6.0.2",
    "nuxt": "^4.6.1",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "pinia": "^4.0.3",
    "prettier": "^3.9.10",
    "reka-ui": "^2.11.0",
    "sql-formatter": "^15.9.0",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "ulid": "^3.0.2",
    "vitest": "^5.0.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13",
    "zod": "^4.6.7"
  }
}
